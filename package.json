{
  "name": "furni",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:perf": "playwright test -c tests/perf",
    "size-limit": "size-limit",
    "db:up": "docker compose up -d postgres redis minio",
    "db:migrate": "pnpm --filter api prisma migrate dev && pnpm db:rls",
    "db:rls": "psql $DATABASE_URL -f apps/api/prisma/migrations/0001_init/rls.sql"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@size-limit/preset-app": "^11.1.0",
    "eslint": "^9.13.0",
    "eslint-plugin-local-rules": "^3.0.2",
    "prettier": "^3.3.0",
    "size-limit": "^11.1.0",
    "turbo": "^2.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "size-limit": [
    { "name": "embed shell", "path": "packages/embed/dist/embed.js", "limit": "8 kB" },
    { "name": "3D engine chunk", "path": "apps/web/dist/assets/engine-*.js", "limit": "500 kB" }
  ]
}
