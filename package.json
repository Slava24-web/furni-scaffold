{
  "name": "furni",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "models:test": "pnpm --filter @furni/pipeline models:test",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:perf": "playwright test -c tests/perf",
    "size-limit": "size-limit",
    "db:up": "docker compose up -d postgres redis minio",
    "db:migrate": "pnpm --filter api prisma migrate deploy && pnpm db:rls",
    "db:seed": "DATABASE_URL=\"$DATABASE_ADMIN_URL\" node apps/api/prisma/seed.mjs",
    "db:rls": "psql \"$DATABASE_ADMIN_URL\" -v ON_ERROR_STOP=1 -f apps/api/prisma/dev-app-role.sql -f apps/api/prisma/migrations/0001_init/rls.sql"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@size-limit/preset-app": "^11.1.0",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9.13.0",
    "eslint-plugin-local-rules": "^3.0.2",
    "prettier": "^3.3.0",
    "size-limit": "^11.1.0",
    "turbo": "^2.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^9"
  },
  "size-limit": [
    {
      "name": "3D engine chunk",
      "path": "apps/web/dist/assets/engine-*.js",
      "limit": "500 kB"
    }
  ]
}
